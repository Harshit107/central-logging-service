# Central Logging Service Configuration

# Service Port (Default: 5001)
PORT=5001

# MongoDB Connection String
# Reuses existing database from FreelyEmail-API
# Local: mongodb://localhost:27017/freelyEmail
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/freelyEmail?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017/freelyEmail

# Inter-Service Authentication Secret
# Client services and the Dashboard proxy MUST pass this value in the `x-logging-key` header
LOGGING_SERVICE_API_KEY=your-secure-logging-service-key-here
